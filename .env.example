# Copiar a .env (gitignorado) y rellenar con las credenciales reales.
# Ver docs/missions/02-base-de-datos-y-auth/ingenieria.md y
# .claude/skills/arquitectura/references/recetas.md para el detalle de cada una.

# --- Supabase: Postgres vía Drizzle (A-001, A-003) ---

# Supavisor, modo transacción, puerto 6543 — la app se conecta acá (Settings > Database > Connection string > Transaction pooler)
NUXT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres

# Supavisor, modo sesión, puerto 5432 — la usa drizzle-kit para migraciones. NO es la conexión
# directa (db.<ref>.supabase.co): esa es IPv6-only sin el add-on pagado y falla en redes sin
# salida IPv6 (muchas residenciales/corporativas la tienen rota o ausente). El pooler en modo
# sesión tiene IPv4 y soporta todo lo que las migraciones necesitan (prepared statements
# incluidos) — mismo host que NUXT_DATABASE_URL, solo cambia el puerto (5432, no 6543).
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth (A-002) ---

# Settings > API > service_role / secret key — nunca a runtimeConfig.public
NUXT_SUPABASE_SECRET_KEY=

# Settings > API > Project URL y publishable key — públicas por diseño (A-001)
NUXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=

# --- Resend: correo transaccional (T-003) ---

NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
